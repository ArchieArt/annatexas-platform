// ─────────────────────────────────────────────────────────────
// W2-00 · Analytics instrumentation layer (Work Order #2)
// Privacy: aggregate-only by design. Stores actor ROLE + internal
// userId (for one-per-account dedupe) — never names/emails/free text.
// ─────────────────────────────────────────────────────────────
enum AnalyticsEventType {
  LISTING_VIEW
  LISTING_CLICK
  OFFER_VIEW
  OFFER_CLAIM
  OFFER_REDEMPTION
  EVENT_RSVP
  JOB_VIEW
  SIERRA_QUESTION
  SURVEY_RESPONSE
  VOLUNTEER_SIGNUP
  MAGAZINE_VIEW
  MAGAZINE_FRAME_CLAIM
  MAGAZINE_CONTRIB_SUBMIT
  INTRO_POSTED
  INTRO_REPLIED
  CARD_VIEW
  VCARD_DOWNLOAD
  CARD_SHARE
  QR_SCAN
  SEAL_SCAN
  // ── Passive harvest layer (Boots on the Ground) ──
  PAGE_VIEW
  ELEMENT_CLICK
  DWELL
  SEARCH_QUERY
  SCROLL_DEPTH
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  actorRole  String             @default("anonymous") // NEWCOMER|RESIDENT|PROVIDER|ADMIN|anonymous
  userId     String? // internal id only — never surfaced in aggregates
  entityType String? // provider | carePackage | survey | job | welcomeBoardPost | magazine | event
  entityId   String?
  topic      String? // categorization bucket for SIERRA_QUESTION (schools, utilities, city_services, ...)
  // ── Passive harvest layer. All optional/additive. ──
  path       String? // route the signal came from, query string stripped
  dwellMs    Int? // ms of attention on that path (DWELL only)
  anonId     String? // rotating pseudonymous visitor id — no PII, cookie-scoped
  elementData Json? // { tag, role, href, label } for ELEMENT_CLICK — never free text from inputs
  createdAt  DateTime           @default(now())

  @@index([type, createdAt])
  @@index([entityType, entityId])
  @@index([topic, createdAt])
  @@index([createdAt])
  @@index([path, createdAt])
  @@index([anonId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// ANNA LIFE MAGAZINE — the frame-based, deadline-driven content engine.
// Structural model borrows from Typst (layout = explicit set-rule JSON on each
// frame) and Editor.js (content = clean typed block JSON). Sierra runs the
// editorial layer. Payouts are admin-approved manual (no auto money movement).
// ─────────────────────────────────────────────────────────────
enum MagazineIssueStatus {
  DRAFT // being set up, not public
  OPEN // claim board live — creators may claim frames, ads on sale
  CONTENT_LOCKED // 25th: no new claims/drafts; editing + ad sales continue
  PROOF // 30th: layout/proof; everything frozen
  PUBLISHED // 1st: live issue
  ARCHIVED
}

enum MagazineFrameType {
  PHOTO // image-led frame (cover, photo essay)
  LONGFORM // multi-page feature
  COLUMN // recurring column
  PROFILE // spotlight / kind deed
  DATA // auto data spread (survey results)
  LISTINGS // auto digest (jobs, nonprofits, classifieds)
}

enum MagazineFrameFillMode {
  CLAIMABLE // a creator claims and writes it (pays a revenue share)
  AUTO // auto-filled from live platform content (no payout)
  CIVIC // reserved for city / council voice (no payout)
}

enum MagazineFrameStatus {
  EMPTY // open to claim
  CLAIMED // a creator owns it, no draft yet
  DRAFT_IN // creator submitted a draft
  IN_REVIEW // Sierra/admin reviewing
  EDITED // edited & fact-checked, ready
  LOCKED // final, cannot change
}

enum MagazineAdSize {
  FULL
  HALF
  QUARTER
  EIGHTH // Coupon Clipper 1/8 page
  SIXTEENTH // Business-card 1/16 page
}

enum MagazineAdStatus {
  OPEN
  RESERVED
  SOLD
}

enum MagazinePayoutStatus {
  PENDING // computed, awaiting admin approval
  APPROVED // admin approved the amount
  PAID // admin marked as paid (manual money movement)
}

// ---- Editorial covenant (byline protection) ----
// Every submission is version-stamped. The first submission is an immutable
// ORIGINAL, preserved forever with its timestamp. All later edits are appended
// as REVISIONs; editing never rewrites history and never changes authorship.
enum MagazineVersionKind {
  ORIGINAL // the author's first submission — immutable, never overwritten
  REVISION // any later edit; appended, authorship carried forward unchanged
}

// Credit lines are kept separate from the content and from each other, so an
// editor's work is credited as editing — not authorship.
enum MagazineCreditRole {
  WRITTEN_BY // the byline / author(s) — protected
  EDITED_BY // editing is credited as editing, never as authorship
  ADDITIONAL_REPORTING
  PHOTOGRAPHY
  AI_ASSISTED // disclosed AI assistance
}

enum MagazineCreditStatus {
  PROPOSED // suggested, not yet live (byline changes wait here for author approval)
  APPROVED // live on the piece
  REJECTED // declined by the affected author
}

enum ContributorType {
  WRITER
  JOURNALIST
  ARTIST
  PHOTOGRAPHER
  INTERVIEWER
  HISTORIAN
  COLUMNIST
  STUDENT
  CORRESPONDENT
  OTHER
}

// Which side of the wall an applicant is joining. Editorial and advertising
// are kept strictly separate: a REVENUE_PARTNER can never buy editorial coverage.
enum ContributorProgram {
  CONTRIBUTOR // Anna LIFE Contributor Network (editorial)
  REVENUE_PARTNER // Anna LIFE Revenue Partner Program (advertising / sponsorship sourcing)
}

enum MagazineContributorStatus {
  PENDING // application submitted, awaiting review
  APPROVED // vetted contributor, may claim sections
  REJECTED // not accepted
  PAUSED // previously approved, temporarily inactive
}

// Application + agreement record for the Anna Life contributor program.
// The commission mechanics already live in MagazineFrame.weight / MagazinePayout;
// this model is the vetting + agreement layer (independent-contractor terms,
// W-9 acknowledgment, first-right understanding).
model MagazineContributor {
  id     String  @id @default(cuid())
  userId String? // optional link to a platform account

  program      ContributorProgram @default(CONTRIBUTOR)
  name         String
  email        String             @unique
  phone        String?
  type         ContributorType    @default(WRITER)
  bio          String? // experience / background
  portfolioUrl String?
  pitch        String? // what they'd like to cover / what they can source

  // Agreement acknowledgments (required set varies by program)
  agreedContractorTerms  Boolean @default(false) // independent contractor, not employment
  commissionAcknowledged Boolean @default(false) // paid from ad-revenue pool after publication + approval
  w9Acknowledged         Boolean @default(false) // will provide a W-9 before first payout
  firstRightAgreed       Boolean @default(false) // first-publication rights + license (contributor); not blanket exclusivity
  editorialFirewallAck   Boolean @default(false) // revenue partners: cannot sell/promise editorial coverage or rankings
  writtenAgreementAck    Boolean @default(false) // will sign a written agreement (rights, pay, attribution, corrections, conduct, confidentiality, termination)

  status    MagazineContributorStatus @default(PENDING)
  adminNote String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt

  pressCredential PressCredential? // issued only after approval, by an editor

  @@index([status, createdAt])
}

model MagazineIssue {
  id            String              @id @default(cuid())
  slug          String              @unique // e.g. "2026-08"
  tenantId      String? // multi-tenant scope (backfilled to anna-tx); additive, nullable for safety
  monthLabel    String // "August 2026"
  year          Int
  month         Int // 1-12
  status        MagazineIssueStatus @default(DRAFT)
  theme         String?
  coverPhotoUrl String?

  // Monthly clock (Typst-style deadline rules)
  claimOpenAt   DateTime?
  contentLockAt DateTime? // 25th
  adLockAt      DateTime? // 25th
  proofAt       DateTime? // 30th
  publishAt     DateTime? // 1st

  // Payout policy snapshot (percent of ad revenue to creator pool)
  creatorPoolPct Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  frames  MagazineFrame[]
  adPlots MagazineAdPlot[]
  payouts MagazinePayout[]
  ledger  MagazineIssueLedger[]

  @@index([status, publishAt])
  @@index([year, month])
}

// Persistent status ledger (the "planning-with-files" pattern): one row per
// state change so Sierra and admins can reconstruct issue state without relying
// on conversation memory. Append-only by convention.
model MagazineIssueLedger {
  id      String        @id @default(cuid())
  issueId String
  issue   MagazineIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  entity    String // "issue" | "frame:<key>" | "adPlot:<label>" | "payout:<recipient>"
  fromState String?
  toState   String?
  note      String?
  actor     String  @default("system") // "admin" | "sierra" | "system"

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

model MagazineFrame {
  id      String        @id @default(cuid())
  issueId String
  issue   MagazineIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  key       String // stable slot key, e.g. "feature_story"
  title     String
  subtitle  String?
  frameType MagazineFrameType
  fillMode  MagazineFrameFillMode @default(CLAIMABLE)
  weight    Int                   @default(0) // payout shares (feature 3 / column 2 / spotlight 1)

  // Typst-modeled layout rules (explicit "set rules" for this frame)
  layout Json // { pageSpan, columns, wordTarget, imageSlots, order }
  order  Int  @default(0)

  status MagazineFrameStatus @default(EMPTY)

  // Claim
  claimedById   String?
  claimedByName String?
  claimedAt     DateTime?

  // Content — Editor.js-style typed block document
  blocks    Json? // { time, version, blocks: [{ type, data }] }
  wordCount Int   @default(0)

  // Editorial layer
  editorNotes     String?
  factCheckStatus String  @default("UNCHECKED") // UNCHECKED | FLAGGED | VERIFIED

  // Copyright covenant: the author retains copyright; Anna LIFE takes only a
  // non-exclusive first-publication license. Set from the ORIGINAL submission.
  copyrightHolderId   String?
  copyrightHolderName String?
  licenseType         String  @default("NON_EXCLUSIVE_FIRST_PUBLICATION")

  versions MagazineSubmissionVersion[]
  credits  MagazineCredit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issueId, key])
  @@index([issueId, status])
  @@index([claimedById])
}

// Append-only submission history for a frame. The row with kind=ORIGINAL is
// written exactly once and is never updated or deleted — it is the permanent,
// timestamped proof of what the author first turned in.
model MagazineSubmissionVersion {
  id      String        @id @default(cuid())
  frameId String
  frame   MagazineFrame @relation(fields: [frameId], references: [id], onDelete: Cascade)
  issueId String

  versionNo Int
  kind      MagazineVersionKind @default(REVISION)

  // The person whose work this is. Captured from the ORIGINAL and carried
  // forward unchanged on every REVISION — editing never reassigns it.
  authorId   String?
  authorName String

  // Who actually saved this particular snapshot (author on ORIGINAL, an editor
  // on a REVISION). Recorded for transparency, separate from authorship.
  savedById   String?
  savedByName String

  blocks    Json
  wordCount Int     @default(0)
  note      String?

  createdAt DateTime @default(now())

  @@unique([frameId, versionNo])
  @@index([frameId, createdAt])
}

// A single credit line on a piece. Byline (WRITTEN_BY) changes require the
// affected author's affirmative approval before they can go live.
model MagazineCredit {
  id      String        @id @default(cuid())
  frameId String
  frame   MagazineFrame @relation(fields: [frameId], references: [id], onDelete: Cascade)
  issueId String

  role       MagazineCreditRole
  personId   String?
  personName String
  detail     String? // e.g. "Draft outline AI-assisted, human-reported and edited"
  order      Int                  @default(0)
  status     MagazineCreditStatus @default(APPROVED)

  // Byline protection
  requiresAuthorApproval Boolean   @default(false)
  approvedByAuthor       Boolean   @default(false)
  approvedAt             DateTime?

  // Who proposed this credit / change (an editor or admin)
  proposedById   String?
  proposedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([frameId, role])
  @@index([personId, status])
}

model MagazineAdPlot {
  id      String        @id @default(cuid())
  issueId String
  issue   MagazineIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  size       MagazineAdSize
  label      String // "Full Page A", "Half Page 2", ...
  priceCents Int
  order      Int              @default(0)
  status     MagazineAdStatus @default(OPEN)

  // Buyer
  providerId       String?
  businessName     String?
  artworkUrl       String?
  artworkCloudPath String?
  soldAt           DateTime?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId, status])
}

model MagazinePayout {
  id      String        @id @default(cuid())
  issueId String
  issue   MagazineIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  frameId         String? // the frame this payout is for (null = adjustment)
  frameKey        String?
  recipientName   String
  recipientUserId String?

  shares      Int                  @default(0)
  amountCents Int                  @default(0)
  status      MagazinePayoutStatus @default(PENDING)
  method      String? // how it was paid (manual)
  note        String?
  approvedAt  DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId, status])
}

// ---------------------------------------------------------------------------
// Anna LIFE Digital PRESS Card (Work Order — July 2026)
//
// A public, verifiable, revocable editorial credential issued to APPROVED
// Anna LIFE contributors. It sits adjacent to the existing digital business-
// card engine and reuses its patterns (public slug, QR, vCard, scan
// analytics, lit/grey contact icons).
//
// PHASE 1-2 SCOPE (this build): credential foundation + public card + admin
// issuance/lifecycle + audit trail. Later phases (specified, not built):
// contributor self-edit dashboard, full Request-This-Contributor case
// workflow, article credits + portfolio feed, ranking snapshots, wallet passes.
//
// A contributor can NEVER self-assign level, dates, credential ID, status,
// residency-verification, published-work count, or ranking. Those are set only
// by an accountable human editor/admin and every change is audited.
// ---------------------------------------------------------------------------

enum PressLevel {
  PROVISIONAL // silver / pearl — supervised publication stage
  CERTIFIED // metallic-gold frame + seal
  SENIOR // gold with senior ribbon
  CONTRIBUTING_EDITOR // black / ivory / gold — invite only
}

enum PressStatus {
  ACTIVE // verified and active
  SUSPENDED // temporarily inactive (muted amber)
  EXPIRED // certification lapsed (grey)
  REVOKED // no longer valid (red status notice)
}

model PressCredential {
  id            String @id @default(cuid())
  contributorId String @unique // 1:1 with the vetted MagazineContributor record
  credentialId  String @unique // human-facing ID printed on the card, e.g. AL-2026-0007
  slug          String @unique // stable public route: /anna-life/press/{slug}

  level  PressLevel  @default(PROVISIONAL)
  status PressStatus @default(ACTIVE)

  // Public display fields — every direct-contact field is OPT-IN. A null field
  // renders as a greyed, disabled icon with accessible helper text.
  headshotUrl   String?
  publicBio     String? // 75-200 word public biography
  publicPhone   String? // approved public/business number (opt-in)
  publicEmail   String? // approved public email or Anna LIFE alias (opt-in)
  publicWebsite String? // website / portfolio
  publicSocial  String? // one approved professional social link
  beats         String? // comma-separated coverage beats shown on the card

  acceptingRequests Boolean @default(true) // Request This Contributor enabled
  residencyVerified Boolean @default(false) // Anna, TX residency confirmed by an editor

  // Credential lifecycle (editor-controlled only)
  issuedAt         DateTime  @default(now())
  approvedAt       DateTime?
  expiresAt        DateTime? // certification term (typically 12 months)
  lastVerifiedAt   DateTime  @default(now())
  approvedByUserId String?
  suspendedAt      DateTime?
  revokedAt        DateTime?

  publicStatusMessage  String? // optional public notice for suspended/expired/revoked
  internalStatusReason String? // private editor note — never shown publicly

  scanCount Int @default(0) // lightweight QR/scan counter (privacy-respecting)
  viewCount Int @default(0) // card page views

  // Governed self-edit: a contributor may PROPOSE changes to their public fields.
  // Nothing here goes live until an editor approves it (copies pending -> public).
  hasPendingEdits    Boolean   @default(false)
  pendingSubmittedAt DateTime?
  pendingHeadshotUrl String?
  pendingBio         String?
  pendingPhone       String?
  pendingEmail       String?
  pendingWebsite     String?
  pendingSocial      String?
  pendingBeats       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributor      MagazineContributor    @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  audits           PressCredentialAudit[]
  coverageRequests CoverageRequest[]

  @@index([status, level])
}

model PressCredentialAudit {
  id           String @id @default(cuid())
  credentialId String // FK to PressCredential.id (internal id, not the public credentialId)

  action            String // ISSUE | RENEW | SUSPEND | RESTORE | EXPIRE | REVOKE | UPDATE
  previousValue     String?
  newValue          String?
  performedByUserId String?
  reason            String?

  createdAt DateTime @default(now())

  credential PressCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, createdAt])
}

enum CoverageRequestStatus {
  NEW
  SCREENING
  FORWARDED
  ACCEPTED
  DECLINED
  COMPLETED
}

// A "Request This Contributor" case. Created from the public PRESS card, then
// screened by the editorial desk before the contributor is ever contacted.
model CoverageRequest {
  id              String @id @default(cuid())
  credentialId    String // FK to PressCredential.id
  contributorName String // denormalized for admin convenience

  requesterName  String
  requesterEmail String
  requesterPhone String?
  organization   String?
  topic          String? // event / story / business / interview / other
  message        String

  status       CoverageRequestStatus @default(NEW)
  internalNote String? // private editorial note — never shown to requester or public

  handledByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  credential PressCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([credentialId, createdAt])
}

// ============================================================================
// ANNA OPPORTUNITY CENTER (EDC ARM)
// Shared case data model for the Business Assistance loop:
// business asks for help -> platform triages -> business consents to EDC
// visibility -> EDC reviews -> assigns owner -> makes referral -> records
// outcome -> rolls up into a monthly brief.
// ============================================================================

enum AssistanceNeedType {
  CUSTOMERS
  EMPLOYEES
  CONSTRUCTION
  SPACE
  FUNDING
  PERMITS
  VENDORS
  OTHER
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CaseStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  REFERRED
  RESOLVED
  CLOSED
}

enum CaseOutcomeType {
  RETAINED
  REFERRAL_COMPLETED
  POSITION_FILLED
  FOUNDER_LAUNCHED
  RECRUITED
  EVENT_ACTIVATED
  NO_RESULT
  CLOSED_NO_ACTION
}

// The spine of the Opportunity Center: a single request for help from a local
// business. Only surfaces to the EDC queue once consentToEDC is true.
model BusinessAssistanceCase {
  id                String  @id @default(cuid())
  providerId        String
  businessName      String // denormalized for queue convenience
  submittedByUserId String?

  needType AssistanceNeedType

  summary String
  details String?

  priority CasePriority @default(MEDIUM)
  status   CaseStatus   @default(NEW)

  // Consent gate — the case is only visible to the EDC after the business
  // explicitly opts in to share the request with the Anna Opportunity Center.
  consentToEDC Boolean   @default(false)
  consentAt    DateTime?

  assignedToUserId String?
  nextAction       String?
  dueDate          DateTime?

  outcomeType CaseOutcomeType?
  outcomeNote String?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider    Provider @relation("ProviderCases", fields: [providerId], references: [id], onDelete: Cascade)
  submittedBy User?    @relation("CaseSubmitter", fields: [submittedByUserId], references: [id])
  assignedTo  User?    @relation("CaseAssignee", fields: [assignedToUserId], references: [id])

  notes     CaseNote[]
  referrals CaseReferral[]
  audit     CaseAuditLog[]

  @@index([status, createdAt])
  @@index([providerId])
  @@index([consentToEDC, status])
}

model CaseNote {
  id           String   @id @default(cuid())
  caseId       String
  authorUserId String?
  authorName   String
  body         String
  isInternal   Boolean  @default(true)
  createdAt    DateTime @default(now())

  assistanceCase BusinessAssistanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model CaseReferral {
  id             String   @id @default(cuid())
  caseId         String
  referredTo     String // Chamber / City / ArtsCouncil / Mentor / Other
  referredToName String?
  note           String?
  status         String   @default("SENT")
  createdAt      DateTime @default(now())

  assistanceCase BusinessAssistanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model CaseAuditLog {
  id          String   @id @default(cuid())
  caseId      String
  actorUserId String?
  actorName   String?
  action      String
  detail      String?
  createdAt   DateTime @default(now())

  assistanceCase BusinessAssistanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

// ============================================================================
// UNIFIED IDENTITY / MULTI-ROLE (Slice 1)
// One Anna identity holds many verified roles. Additive layer on top of the
// existing single `User.role` field — the primary role still drives existing
// middleware redirects; these assignments unlock dashboard tabs in "My Anna".
// ============================================================================

enum CommunityRole {
  RESIDENT
  BUSINESS
  NONPROFIT
  ARTIST
  PRESS
  CITY_COUNCIL
  EDC
  CITY_STAFF
  VOLUNTEER
  SPONSOR
}

enum RoleAssignmentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  DENIED
  SUSPENDED
  EXPIRED
}

// Graduated verification ladder (verification != authorization).
enum VerificationLevel {
  SELF_DECLARED
  OWNERSHIP_VERIFIED
  EDITORIALLY_APPROVED
  INSTITUTIONALLY_CONFIRMED
  PRIVILEGED_ADMIN
}

model UserRoleAssignment {
  id                    String               @id @default(cuid())
  userId                String
  role                  CommunityRole
  status                RoleAssignmentStatus @default(SUBMITTED)
  verification          VerificationLevel    @default(SELF_DECLARED)
  orgName               String? // linked org / business / nonprofit name
  title                 String? // e.g. "Council Member, Place 4", "Founder"
  note                  String? // applicant's justification / note
  reviewerNote          String? // admin note on approve/deny
  profile               Json? // role-specific workspace profile (bio, links, needs, etc.)
  proofUrl              String? // applicant-supplied proof link for verification level-up
  proofNote             String? // applicant note describing their proof
  verificationRequested VerificationLevel? // target tier the user is requesting (level-up)
  reviewedByUserId      String?
  reviewedAt            DateTime?
  submittedAt           DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  user User @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Citynest — City Manager Command Center (Slice 1)
// The Department Agent Swarm: a directive (meeting transcript, Council
// directive, or department plan) is dropped in, AI organizes it into
// departmental tasks with drafted first-steps that leave the Manager's desk.
// ─────────────────────────────────────────────────────────────
model CityDirective {
  id            String   @id @default(cuid())
  title         String
  sourceType    String   @default("MEETING") // MEETING, COUNCIL, PLAN, MEMO
  rawText       String
  summary       String? // AI executive summary of the whole directive
  status        String   @default("PROCESSING") // PROCESSING, ORGANIZED, FAILED
  createdById   String?
  createdByName String?  @default("City Manager")
  taskCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks CityTask[]

  @@index([status, createdAt])
}

model CityTask {
  id          String   @id @default(cuid())
  directiveId String
  department  String   @default("General")
  title       String
  detail      String?
  priority    String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  status      String   @default("TODO") // TODO, IN_PROGRESS, DONE
  draftOutput String? // AI-drafted first-step / work product for this task
  dueHint     String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  directive CityDirective @relation(fields: [directiveId], references: [id], onDelete: Cascade)

  @@index([directiveId])
  @@index([department, status])
  @@index([status])
