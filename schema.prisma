generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/welcome_to_anna/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserRole {
  NEWCOMER
  RESIDENT
  PROVIDER
  NONPROFIT
  ARTIST
  ADMIN
  CHAMBER
  CITY
  EDC
  GUEST
  SPONSOR
}

enum ProviderTier {
  FREE
  CONNECTED
  PRIORITY
}

enum ProviderStatus {
  NEW
  PHANTOM
  CLAIMED
  CERTIFIED
}

enum ProviderSource {
  ADMIN
  SURVEY
  REQUESTED
  NOMINATED
}

enum LeadStatus {
  DELIVERED
  VIEWED
  RESPONDED
  CONVERTED
  DECLINED
  EXPIRED
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String?
  name                String?
  phone               String?
  role                UserRole @default(NEWCOMER)
  isVerifiedResident  Boolean  @default(false)
  onboardingCompleted Boolean  @default(false)
  answers             Json? // Onboarding questionnaire answers
  tags                String[] @default([])
  preferences         Json? // Communication preferences etc
  dataConsent         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastActive          DateTime @default(now())

  referralCode         String? @unique
  referredById         String?
  referralTokensEarned Int     @default(0)
  tokenBalance         Int     @default(0) // Resident/newcomer token wallet (garage sales, classifieds, etc.)

  // Resident-to-resident neighbor matching (opt-in)
  neighborConnectEnabled Boolean @default(false)
  neighborBio            String?

  // ---- Personal Digital Card (shared card engine; all member roles) ----
  cardEnabled        Boolean   @default(false) // member generated their card (accepted 18+)
  cardSlug           String? // public card URL: /card/{name}-{short-unique} (uniqueness enforced in app)
  cardTitle          String? // optional title/tagline e.g. "Realtor", "New to Anna", "Council Member, Place 4"
  avatarUrl          String? // photo; falls back to initials avatar when null
  cardBannerUrl      String? // optional banner (3:1); shown only when cardBannerStatus == approved
  cardBannerStatus   String?   @default("none") // none | pending | approved | rejected (admin moderation)
  isVerifiedOfficial Boolean   @default(false) // ADMIN-assigned ONLY — never self-selectable
  showNewToAnna      Boolean   @default(false) // member-controlled optional "New to Anna" badge
  cardCity           String?   @default("Anna") // city only — street address is NEVER on a personal card
  // ---- Anna-ONLY front-door gate ----
  // Selected at signup ("what city do you live in?"). Values map to lib/anna-eligibility.ts.
  // Anna city / Anna ETJ = full account; everything else = Guest Pass only.
  homeLocation       String?
  cardFacebookUrl    String?
  cardInstagramUrl   String?
  ageAttested        Boolean   @default(false) // one-time 18+ attestation (personal cards are 18+ only)
  ageAttestedAt      DateTime?
  // Personal card privacy toggles (defaults match the personal-card spec table)
  cardShowPhone      Boolean   @default(false)
  cardShowEmail      Boolean   @default(false)
  cardShowCity       Boolean   @default(true)
  cardShowSocials    Boolean   @default(false)
  cardShowMessage    Boolean   @default(true) // in-app message is the safe default channel

  // Welcome Board Ambassador: opted-in neighbor who gets alerted about unanswered newcomer intros
  isAmbassador Boolean @default(false)

  // Extra login security (email one-time code). Auto-required for official roles/admins;
  // any user may also opt in. See lib/mfa.ts.
  mfaEnabled Boolean @default(false)

  provider          Provider?
  notifications     Notification[]
  volunteerSignups  VolunteerSignup[]         @relation("UserVolunteerSignups")
  leadsAsNewcomer   Lead[]                    @relation("NewcomerLeads")
  carePackageClips  CarePackageClip[]
  sessions          Session[]
  // ---- Admin moderation (ADMIN-only visibility) ----
  accountStatus     String                    @default("active") // active | warned | banned
  moderationNote    String? // latest admin note (reason for warn/ban)
  statusUpdatedAt   DateTime? // when accountStatus last changed
  moderationActions ModerationAction[]        @relation("ModerationTarget")
  moderationsMade   ModerationAction[]        @relation("ModerationActor")
  accounts          Account[]
  submittedCases    BusinessAssistanceCase[]  @relation("CaseSubmitter")
  assignedCases     BusinessAssistanceCase[]  @relation("CaseAssignee")
  roleAssignments   UserRoleAssignment[]      @relation("UserRoles")
  squarePrefs       UserSquarePreference[]    @relation("UserSquarePrefs")
  artistStudio      ArtistStudioProfile?      @relation("UserArtistStudio")
  payoutProfile     ContributorPayoutProfile? @relation("UserPayoutProfile")
  artworks          ArtworkPiece[]            @relation("UserArtworks")
  referredBy        User?                     @relation("Referrals", fields: [referredById], references: [id])
  referrals         User[]                    @relation("Referrals")
  rfpRequests       RfpRequest[]              @relation("RfpAuthor")
  helpRequests      HelpRequest[]             @relation("HelpAuthor")
  platformSubscription PlatformSubscription?  @relation("UserPlatformSub")
  grantConcierge       GrantConciergeSubscription? @relation("UserGrantConcierge")
  listings             Listing[]                   @relation("UserListings")
  newcomerMatches      NewcomerMatch[]           @relation("UserNewcomerMatches")
  onboardingSurvey     UserOnboardingSurvey?

  @@index([role])
  @@index([createdAt])
  @@index([referralCode])
}

// 10-question persona onboarding survey (first sign-in). Drives persona tags + demographic reports.
model UserOnboardingSurvey {
  id              String   @id @default(cuid())
  userId          String   @unique
  livesInAnna     Boolean
  tenureYears     String?  // "<1_year", "1-3_years", etc.
  movedFrom       String?  // "McKinney, TX", "California", etc.
  ageRange        String   // "25-34", "35-49", etc.
  worksInAnna     Boolean
  isJobSeeker     Boolean  @default(false)
  isStudent       Boolean  @default(false)
  ownsBusiness    Boolean  @default(false)
  openingBusiness Boolean  @default(false)
  isArtist        Boolean  @default(false)
  artistTypes     Json?    // ["Musician", "Painter"]
  completedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Civic Nexus matchmaking — a saved, auditable record of what each resident's
// onboarding answers matched them to across the platform's live inventories
// (businesses, jobs, grants, events, volunteer + nonprofit + magazine work).
// Recomputed on survey completion. Powers the resident dashboard AND the
// role-based executive report. Scores/reasons are computed from real data only.
model NewcomerMatch {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("UserNewcomerMatches", fields: [userId], references: [id], onDelete: Cascade)
  category   String   // BUSINESS | JOB | GRANT | EVENT | VOLUNTEER | NONPROFIT | ART_ASSIGNMENT
  targetId   String
  title      String
  subtitle   String?
  href       String
  matchScore Int      // 0-100 relevance, computed from the resident's stated intent
  reason     String   // plain-language why this matched — shown to the resident
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, category, targetId])
  @@index([userId, matchScore])
  @@index([category, createdAt])
}

// Platform SaaS membership subscription (audience-specific recurring plan).
// SEPARATE from the Provider lead/token tiers and the Digital Card add-ons.
//   plan: ENTERPRISE (business) | NONPROFIT | ARTIST
// One active membership per user account.
model PlatformSubscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             String // ENTERPRISE | NONPROFIT | ARTIST
  status           String    @default("active") // active | canceling | canceled | past_due
  priceCents       Int
  stripeCustomerId String?
  stripeSubId      String?   @unique
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation("UserPlatformSub", fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Provider {
  id                   String         @id @default(cuid())
  userId               String?        @unique
  businessName         String
  category             String
  subcategory          String?
  description          String?
  tier                 ProviderTier   @default(FREE)
  phone                String?
  email                String?
  website              String?
  address              String?
  city                 String?        @default("Anna")
  state                String?        @default("TX")
  zip                  String?        @default("75409")
  hours                Json? // Operating hours
  tags                 String[]       @default([])
  isVerified           Boolean        @default(false) // Chamber verified (legacy single flag)
  isChamberMember      Boolean        @default(false)
  ownershipVerified    Boolean        @default(false) // Identity/ownership documentation reviewed
  certifiedConnector   Boolean        @default(false) // Completed platform Certified Connector process
  setupFeePaid         Boolean        @default(false)
  stripeCustomerId     String?
  stripeSubId          String?
  subscriptionEnd      DateTime?
  tokenBalance         Int            @default(0)
  totalLeads           Int            @default(0)
  totalConverted       Int            @default(0)
  status               ProviderStatus @default(PHANTOM)
  source               ProviderSource @default(ADMIN)
  claimCode            String?        // printed on QR/cling/ad — used for claim attribution
  sourceDoor           String?        // print_digital | founder | transactional | referral | organic | civic
  referredById         String?        // Provider id that referred this one (Door 4)
  ownerName            String?
  ownerEmail           String?
  taxId                String?
  logoUrl              String?
  bannerUrl            String? // Wide header image for personalized tile (paid feature)
  facebookUrl          String? // Social link — lights the Facebook icon (all tiers)
  instagramUrl         String? // Social link — lights the Instagram icon (all tiers)
  youtubeUrl           String? // Social link — lights the YouTube icon (all tiers); feeds MarketBoost
  candidUrl            String? // Nonprofit transparency profile (Candid/GuideStar) — required for nonprofits
  candidVerified       Boolean        @default(false) // Shows the "Verified with Candid" trust mark
  brandPrimary         String? // Hex color for personalized tile (paid feature)
  brandAccent          String? // Hex accent color for personalized tile (paid feature)
  tilePersonalized     Boolean        @default(false) // Master toggle for branded tile
  tileShowDeals        Boolean        @default(true)
  tileShowListings     Boolean        @default(true)
  tileShowEvents       Boolean        @default(true)
  tileShowMessage      Boolean        @default(true)
  // Personalized tile engagement counters (only tracked for paid tiles)
  tileViews            Int            @default(0)
  clickPhone           Int            @default(0)
  clickWebsite         Int            @default(0)
  clickDeals           Int            @default(0)
  clickListings        Int            @default(0)
  clickEvents          Int            @default(0)
  clickMessage         Int            @default(0)
  clickFacebook        Int            @default(0)
  clickInstagram       Int            @default(0)
  clickReviews         Int            @default(0)
  qrScans              Int            @default(0) // Profile opens attributed to a QR scan (?src=qr)
  cardSlug             String? // public business card URL: /card/{business-slug} (uniqueness enforced in app)
  bannerStatus         String?        @default("none") // none | pending | approved | rejected (banner moderation)
  // --- W2-12 Digital Card monetization add-ons (SEPARATE from lead/token tier above) ---
  cardTier             String?        @default("free") // free | starter | growth | premium (monthly card add-on)
  cardTierStatus       String?        @default("inactive") // inactive | active | canceling
  cardAddonSubId       String? // Stripe subscription id for the card add-on (distinct from stripeSubId)
  cardStripeCustomerId String? // Stripe customer id used for the card add-on subscription
  cardTierRenewsAt     DateTime? // current period end / next renewal for the card add-on
  cardAddOns           Json? // lightweight add-on content payload (deals, hours, socials, bio, etc.)
  cardHasDeal          Boolean        @default(false) // lightweight scalar so directory tiles show "+Deals" without parsing JSON
  awards               String[]       @default([]) // e.g., "Voted #1 in Coffee"
  progressNotes        String?
  stageUpdatedAt       DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user            User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads           Lead[]                   @relation("ProviderLeads")
  tokenPurchases  TokenPurchase[]
  jobs            Job[]
  events          Event[]
  volunteerOpportunities VolunteerOpportunity[]
  carePackages    CarePackage[]
  testimonials    Testimonial[]
  messages        ProviderMessage[]
  assistanceCases BusinessAssistanceCase[] @relation("ProviderCases")
  rfpBids         RfpBid[]                 @relation("ProviderBids")
  sponsoredQuestions SponsoredQuestion[]   @relation("ProviderSponsoredQuestions")

  @@index([category])
  @@index([tier])
  @@index([isVerified])
  @@index([status])
}

// Match-Marketing "Ask a Newcomer a Question" — an exclusive, sponsored survey
// question owned by ONE business. Affirmative answers become exclusive leads for
// that owner only (never shared). Priced per 30-day evaluation window; the floor
// is MATCH_MARKETING_MIN_TOKENS ($10 equivalent). Owner-editable tiles: question,
// options, tags, channel (audience), industry.
model SponsoredQuestion {
  id           String   @id @default(cuid())
  providerId   String? // Owning business; null while an admin drafts it
  question     String
  options      String[] @default([])
  tags         String[] @default([]) // routing tags matched against newcomer needs
  channel      String   @default("PROVIDER") // audience pool: PROVIDER | NONPROFIT | ARTIST (CITY/RESIDENT stay free, not sold here)
  industry     String? // for by-industry pricing + analytics filtering
  triggerAnswers String[] @default(["yes", "recommend"]) // answers that create a lead
  priceTokens  Int      @default(10) // tokens charged for the 30-day window ($10 floor)
  status       SponsoredQuestionStatus @default(DRAFT)
  exclusive    Boolean  @default(true) // lead goes ONLY to the owner
  startsAt     DateTime?
  expiresAt    DateTime? // end of the paid 30-day evaluation window
  impressions  Int      @default(0) // times shown to a newcomer
  responses    Int      @default(0) // affirmative answers (leads generated)
  leadsOpened  Int      @default(0) // leads the owner engaged/opened
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider Provider? @relation("ProviderSponsoredQuestions", fields: [providerId], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([status])
  @@index([industry])
}

enum SponsoredQuestionStatus {
  DRAFT // being set up
  PENDING // submitted, awaiting admin approval
  ACTIVE // live in the survey, within paid window
  PAUSED // temporarily off
  EXPIRED // 30-day window ended
}

// Customer testimonials shown on a business profile (moderated).
model Testimonial {
  id          String   @id @default(cuid())
  providerId  String
  authorName  String
  authorEmail String?
  rating      Int      @default(5) // 1-5 stars
  text        String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, isApproved])
  @@index([createdAt])
}

// Direct in-app messages sent from a resident to a business profile.
model ProviderMessage {
  id           String   @id @default(cuid())
  providerId   String
  senderName   String
  senderEmail  String
  senderPhone  String?
  message      String
  senderUserId String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, isRead])
  @@index([createdAt])
}

model Lead {
  id          String     @id @default(cuid())
  newcomerId  String
  providerId  String
  category    String
  matchScore  Float      @default(0)
  status      LeadStatus @default(DELIVERED)
  tokenCost   Int        @default(1)
  summary     String? // Anonymized needs summary
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  respondedAt DateTime?

  newcomer User     @relation("NewcomerLeads", fields: [newcomerId], references: [id])
  provider Provider @relation("ProviderLeads", fields: [providerId], references: [id])

  @@index([providerId, status])
  @@index([newcomerId])
  @@index([createdAt])
}

model TokenPurchase {
  id              String   @id @default(cuid())
  providerId      String
  amount          Int // Number of tokens
  pricePaid       Float // Dollar amount (legacy — kept for backward compatibility)
  pricePaidCents  Int? // Authoritative money value stored as integer cents
  stripePaymentId String?
  createdAt       DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

// Idempotent ledger of promotional / bonus token grants. One row per (reason,recipient)
// via the unique grantKey so a grant can never be issued twice, and the admin Token
// Analytics tab can total how many tokens were handed out per program.
model TokenGrant {
  id         String   @id @default(cuid())
  userId     String? // resident recipient (User.id)
  providerId String? // business recipient (Provider.id)
  amount     Int
  reason     String // BUSINESS_SETUP | LISTING_CLAIM | RESIDENT_ONBOARD
  grantKey   String   @unique // `${reason}:${userId||providerId}` — enforces one grant per recipient/program
  createdAt  DateTime @default(now())

  @@index([reason, createdAt])
}

// Idempotency ledger for Stripe webhook events. Every processed event id is
// recorded here so a replayed or forged-duplicate event can never double-credit
// tokens, re-mark a business paid, or re-issue a subscription.
model WebhookEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())

  @@index([type])
  @@index([processedAt])
}

model AnnaGraph {
  id          String   @id @default(cuid())
  category    String   @unique
  count       Int      @default(0)
  commonTags  String[] @default([])
  percentage  Float    @default(0)
  lastUpdated DateTime @default(now())

  @@index([category])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  formType  String   @default("contact")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

// Audit trail for every email the Reply Desk sends out. One row per send
// attempt (SENT or FAILED), so admins have a permanent record of outbound
// replies drafted by Sierra Grace.
model MailLog {
  id            String   @id @default(cuid())
  recipient     String
  recipientName String?
  subject       String
  body          String
  status        String   @default("SENT") // SENT | FAILED | QUEUED
  channel       String   @default("reply") // reply | outreach | sequence
  sourceType    String? // contact | message | manual | sequence
  sourceId      String?
  sequenceKey   String? // e.g. BUS_T1
  stepNumber    Int? // step within sequence
  emailedAt     DateTime? // null while QUEUED; set when actually sent
  readAt        DateTime? // in-app read receipt (future)
  sentByEmail   String?
  error         String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([sourceType, sourceId])
  @@index([sequenceKey])
}

// ─── MAILROOM TRIGGER ARCHITECTURE ─────────────────────────────

// Immutable consent ledger — never update a row, only append.
model ConsentLog {
  id           String   @id @default(cuid())
  contactEmail String   // the email address this consent applies to
  contactId    String?  // optional FK to User/Provider — best-effort
  channel      String   @default("email") // email | sms | inapp
  status       String   // GRANTED | WITHDRAWN
  evidence     String   // claim code, form submission ID, agreement ref — NEVER blank
  context      String?  // IP, event name, "in person — [date]"
  grantedAt    DateTime?
  withdrawnAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([contactEmail, channel])
  @@index([createdAt])
}

// One row per contact — tracks active sequence, step, cadence.
model SequenceState {
  id                 String    @id @default(cuid())
  contactEmail       String    // the person in the sequence
  contactId          String?   // optional FK
  segment            String    // BUSINESS | ARTIST | NONPROFIT | NEWCOMER | RESIDENT | MOMENT_KEEPER
  activeSequence     String?   // e.g. BUS_T1 — null if no active sequence
  queuedSequences    String[]  @default([]) // keys waiting their turn
  currentStep        Int       @default(0)
  lastSendAt         DateTime?
  nextEligibleAt     DateTime?
  pausedUntil        DateTime?
  pauseReason        String?   // HumanTouch | Sensitivity | Manual
  consecutiveMisses  Int       @default(0)
  exitReason         String?   // Completed | TwoMiss | Manual | Suppressed
  exitedAt           DateTime?
  entityName         String?   // business/org name for merge tokens
  personName         String?   // contact person name
  providerId         String?   // FK to Provider if BUSINESS
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([contactEmail, activeSequence])
  @@index([segment])
  @@index([activeSequence])
  @@index([nextEligibleAt])
}

// Active suppression rules — one per type per contact.
model Suppression {
  id           String    @id @default(cuid())
  contactEmail String
  contactId    String?
  type         String    // FrequencyCap | HumanTouch | Sensitivity | Unsubscribe | QuietHours
  active       Boolean   @default(true)
  expiresAt    DateTime? // null = permanent
  setBy        String?   // person or system
  note         String?
  createdAt    DateTime  @default(now())

  @@index([contactEmail, type, active])
  @@index([expiresAt])
}

enum StoryCategory {
  KIND_DEED
  LOCAL_STORY
  ANNOUNCEMENT
}

model CommunityStory {
  id         String        @id @default(cuid())
  title      String
  content    String
  category   StoryCategory @default(KIND_DEED)
  authorName String        @default("Anonymous Neighbor")
  authorId   String? // optional link to user
  location   String? // e.g., "Near Harlow Elementary"
  imageUrls  String[]      @default([]) // community photos attached to the story
  videoUrl   String? // optional single video clip
  tags       String[]      @default([]) // auto-generated tags for photo/lead matching
  isApproved Boolean       @default(false)
  likes      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([category])
  @@index([isApproved, createdAt])
}

model Survey {
  id               String           @id @default(cuid())
  question         String
  options          Json // string array, e.g., ["Whataburger", "In-N-Out"]
  isActive         Boolean          @default(true)
  category         String? // e.g., "Dining", "Retail", "Recreation"
  winnerDeclared   Boolean          @default(false) // true once survey hits the vote threshold
  winningOption    String? // the #1 voted option
  winnerProviderId String? // matched provider awarded #1 (if any)
  winnerVotes      Int? // votes the winning option received
  winnerAt         DateTime? // when #1 was declared
  // Community authorship: anyone can propose a survey. Null author == admin/seed.
  authorId         String? // User.id of the neighbor who created it
  authorName       String? // display name shown as "Asked by ..."
  authorRole       String? // Resident | Newcomer | Business | Nonprofit | Admin (display + billing)
  source           String           @default("admin") // admin | community
  tags             String[]         @default([]) // AI topic tags for searching past surveys
  allowWriteIn     Boolean          @default(true) // let neighbors add their own votable answer
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  responses        SurveyResponse[]

  @@index([isActive])
  @@index([winnerDeclared])
  @@index([authorId])
}

model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String   @default("Anna, TX")
  type        String   @default("Full-Time")
  salary      String?
  description String?
  applyUrl    String?
  category    String?
  tags        String[] @default([])
  status      String   @default("active")
  isVerified  Boolean  @default(true)
  postedById  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  postedBy Provider? @relation(fields: [postedById], references: [id])

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  dateString  String
  location    String   @default("Anna, TX")
  description String?
  type        String   @default("community")
  link        String?
  status      String   @default("active")
  postedById  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  postedBy Provider @relation(fields: [postedById], references: [id])

  @@index([status])
  @@index([createdAt])
}

model EventRSVP {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String
  userId    String
  email     String
  name      String
  status    String   @default("CONFIRMED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([tenantId])
